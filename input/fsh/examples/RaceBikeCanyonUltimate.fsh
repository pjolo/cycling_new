Instance: RaceBikeCanyonUltimate
InstanceOf: RaceBike
Title: "Canyon Ultimate CF SLX 8.0 - Anna's Race Bike"
Description: "Anna Müller's Canyon Ultimate CF SLX 8.0 with Shimano Ultegra Di2"
* status = #active
* deviceName[0].name = "Canyon Ultimate CF SLX 8.0"
* deviceName[0].type = #model-name
* deviceName[1].name = "Canyon"
* deviceName[1].type = #manufacturer-name
* property[0].type = RaceBikePropertyType#frame-material
* property[1].type = RaceBikePropertyType#groupset
* property[2].type = RaceBikePropertyType#wheelset