CodeSystem: RideMetricType
Id: ride-metric-type
Title: "Ride Metric Type"
Description: "Fictional code system for cycling ride metrics (fun IG, not a real terminology)."
* ^status = #draft
* ^content = #complete
* #distance "Distance" "Total distance of the ride"
* #duration "Duration" "Total duration of the ride"
* #average-speed "Average Speed" "Average speed during the ride"
* #max-speed "Maximum Speed" "Maximum speed reached during the ride"
* #elevation-gain "Elevation Gain" "Total elevation gain"
* #elevation-loss "Elevation Loss" "Total elevation loss"
* #average-heart-rate "Average Heart Rate" "Average heart rate during ride"
* #max-heart-rate "Maximum Heart Rate" "Maximum heart rate during ride"
* #average-power "Average Power" "Average power output"
* #normalized-power "Normalized Power" "Normalized power (NP)"
* #intensity-factor "Intensity Factor" "Intensity Factor (IF)"
* #training-stress-score "Training Stress Score" "Training Stress Score (TSS)"
* #average-cadence "Average Cadence" "Average pedaling cadence"
* #temperature "Temperature" "Average temperature during ride"
